# Variante locale: richiede `pip install -e .`
[mcp_servers.music-studio]
command = "music-studio-mcp"
enabled = true

[mcp_servers.music-studio.env]
MUSIC_STUDIO_DATA = "/PERCORSO/ASSOLUTO/music/data"

